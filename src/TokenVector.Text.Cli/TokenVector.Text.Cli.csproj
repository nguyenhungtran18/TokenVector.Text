<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <LangVersion>12</LangVersion>
    <RootNamespace>TokenVector.Text.Cli</RootNamespace>
    <AssemblyName>tkv-text</AssemblyName>
    <PackageId>TokenVector.Text.Cli</PackageId>
    <Version>1.0.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tkv-text</ToolCommandName>
    <Description>CLI tool for TokenVector.Text high-throughput tokenizer, BPE trainer, and text encoder/decoder.</Description>
    <Authors>TokenVector Project Team</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TokenVector.Text\TokenVector.Text.csproj" />
  </ItemGroup>

</Project>
